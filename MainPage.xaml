<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:shopping_app.Models"
    x:Class="shopping_app.MainPage"
    Title="Products">

    <Grid Padding="16" RowDefinitions="Auto,*" RowSpacing="12">

        <Label
            x:Name="StatusLabel"
            Text="Loading products..."
            FontSize="16" />

        <CollectionView
            x:Name="ProductsView"
            Grid.Row="1"
            SelectionMode="None"
            ItemsLayout="VerticalList">

            <CollectionView.EmptyView>
                <Label
                    Text="No products to display."
                    Margin="0,24"
                    HorizontalTextAlignment="Center" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Product">
                    <VerticalStackLayout Padding="0,12" Spacing="6">

                        <Label
                            Text="{Binding Name}"
                            FontSize="20"
                            FontAttributes="Bold" />

                        <BoxView
                            Margin="0,8,0,0"
                            HeightRequest="1"
                            Color="{AppThemeBinding Light=#DDDDDD, Dark=#444444}" />

                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>
    </Grid>

</ContentPage>