<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:shopping_app.Models"
    x:Class="shopping_app.MainPage"
    Title="Products">

    <!-- Keep the count and buttons fixed while the middle row scrolls. -->
    <Grid
        Padding="16"
        RowDefinitions="Auto,*,Auto"
        RowSpacing="12">

        <!-- Display the product count with the sort button on the right. -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="12">

            <Label
                x:Name="StatusLabel"
                Text="Loading products..."
                FontSize="16"
                VerticalOptions="Center" />

            <!-- Toggle between alphabetical and reverse alphabetical order. -->
            <Button
                x:Name="SortProductsButton"
                Grid.Column="1"
                Text="A|Z"
                FontSize="14"
                Padding="0"
                WidthRequest="56"
                HeightRequest="56"
                CornerRadius="28"
                Clicked="OnSortProductsClicked"
                SemanticProperties.Description="Sorted A to Z. Tap to sort Z to A." />

        </Grid>

        <!-- Display product names in a vertically scrollable list. -->
        <CollectionView
            x:Name="ProductsView"
            Grid.Row="1"
            SelectionMode="None"
            ItemsLayout="VerticalList">

            <!-- Display a message when the list has no items. -->
            <CollectionView.EmptyView>
                <Label
                    Text="No products to display."
                    Margin="0,24"
                    HorizontalTextAlignment="Center" />
            </CollectionView.EmptyView>

            <!-- Use the same layout for each product. -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Product">
                    <VerticalStackLayout Padding="0,12" Spacing="6">

                        <Label
                            Text="{Binding Name}"
                            FontSize="20"
                            FontAttributes="Bold" />

                        <!-- Separate entries with a theme-aware line. -->
                        <BoxView
                            Margin="0,8,0,0"
                            HeightRequest="1"
                            Color="{AppThemeBinding Light=#DDDDDD, Dark=#444444}" />

                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <!-- Open the product form.
             This button stays below the list while products scroll. -->
        <Button
            x:Name="AddProductButton"
            Grid.Row="2"
            Text="+"
            FontSize="32"
            Padding="0"
            WidthRequest="56"
            HeightRequest="56"
            CornerRadius="28"
            HorizontalOptions="Start"
            Clicked="OnAddProductClicked"
            SemanticProperties.Description="Add a product" />

    </Grid>

</ContentPage>