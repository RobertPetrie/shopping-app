<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:shopping_app.Models"
    x:Class="shopping_app.MainPage"
    Title="Products">

    <!-- Material-style product list with a prominent header and actions. -->
    <Grid
        Padding="24,20"
        RowDefinitions="Auto,*,Auto"
        RowSpacing="18">

        <!-- Page title, product count, and sort action. -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="16">

            <VerticalStackLayout
                Spacing="2"
                VerticalOptions="Center">

                <Label
                    Text="Products"
                    FontSize="30"
                    FontAttributes="Bold" />

                <Label
                    x:Name="StatusLabel"
                    Text="Loading products..."
                    FontSize="14"
                    TextColor="{AppThemeBinding Light=#6B6B6B, Dark=#C7C7C7}" />
            </VerticalStackLayout>

            <Button
                x:Name="SortProductsButton"
                Grid.Column="1"
                StyleClass="FilledTonalButton"
                Text="A → Z"
                FontSize="14"
                Padding="18,10"
                MinimumWidthRequest="92"
                VerticalOptions="Center"
                Clicked="OnSortProductsClicked"
                SemanticProperties.Description="Sorted A to Z. Tap to sort Z to A." />
        </Grid>

        <!-- Product selection is handled by each card's tap gesture. -->
        <CollectionView
            x:Name="ProductsView"
            Grid.Row="1"
            SelectionMode="None"
            ItemsLayout="VerticalList">

            <CollectionView.EmptyView>
                <Border
                    StyleClass="SurfaceContainer,Rounded"
                    Padding="24"
                    Margin="0,24,0,0">

                    <VerticalStackLayout
                        Spacing="6"
                        HorizontalOptions="Center">

                        <Label
                            Text="No products yet"
                            FontSize="18"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="Add your first product below."
                            FontSize="14"
                            TextColor="{AppThemeBinding Light=#6B6B6B, Dark=#C7C7C7}"
                            HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Product">

                    <!-- Keep the outer Grid so the existing saved-row highlight
                         logic can continue tracking recycled CollectionView rows. -->
                    <Grid
                        Padding="3"
                        Margin="0,0,0,10"
                        BackgroundColor="Transparent"
                        Loaded="OnProductRowLoaded"
                        Unloaded="OnProductRowUnloaded"
                        BindingContextChanged="OnProductRowBindingContextChanged">

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                NumberOfTapsRequired="1"
                                Tapped="OnProductTapped"
                                CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>

                        <Border
                            StyleClass="SurfaceContainer,Rounded"
                            Padding="18,16">

                            <Border.Shadow>
                                <Shadow
                                    Opacity="0.12"
                                    Radius="8"
                                    Offset="0,3" />
                            </Border.Shadow>

                            <Grid
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="12">

                                <Label
                                    Text="{Binding Name}"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    VerticalOptions="Center"
                                    SemanticProperties.Hint="Tap to edit product" />

                                <Label
                                    Grid.Column="1"
                                    Text="›"
                                    FontSize="28"
                                    VerticalOptions="Center"
                                    TextColor="{AppThemeBinding Light=#666666, Dark=#C7C7C7}" />
                            </Grid>
                        </Border>
                    </Grid>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <!-- Primary Material action for creating a product. -->
        <Button
            x:Name="AddProductButton"
            AutomationId="AddProductButton"
            Grid.Row="2"
            StyleClass="FilledButton"
            Text="+"
            FontSize="30"
            Padding="0"
            WidthRequest="56"
            HeightRequest="56"
            MinimumWidthRequest="56"
            MinimumHeightRequest="56"
            CornerRadius="28"
            HorizontalOptions="Start"
            Clicked="OnAddProductClicked"
            SemanticProperties.Description="Add a product" />

    </Grid>

</ContentPage>
