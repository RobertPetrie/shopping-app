<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:shopping_app.Models"
    x:Class="shopping_app.MainPage"
    Title="Products">

    <Grid
        Padding="16"
        RowDefinitions="Auto,*,Auto"
        RowSpacing="12">

        <!-- Product count and sort button -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="12">

            <Label
                x:Name="StatusLabel"
                Text="Loading products..."
                FontSize="16"
                VerticalOptions="Center" />

            <Button
                x:Name="SortProductsButton"
                Grid.Column="1"
                Text="Sort"
                FontSize="14"
                Padding="0"
                WidthRequest="56"
                HeightRequest="56"
                CornerRadius="28"
                SemanticProperties.Description="Sort products" />
        </Grid>

        <!-- Scrollable product list -->
        <CollectionView
            x:Name="ProductsView"
            Grid.Row="1"
            SelectionMode="None"
            ItemsLayout="VerticalList">

            <CollectionView.EmptyView>
                <Label
                    Text="No products to display."
                    Margin="0,24"
                    HorizontalTextAlignment="Center" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Product">
                    <VerticalStackLayout Padding="0,12" Spacing="6">

                        <Label
                            Text="{Binding Name}"
                            FontSize="20"
                            FontAttributes="Bold" />

                        <BoxView
                            Margin="0,8,0,0"
                            HeightRequest="1"
                            Color="{AppThemeBinding Light=#DDDDDD, Dark=#444444}" />

                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <!-- Fixed add button -->
        <Button
            x:Name="AddProductButton"
            Grid.Row="2"
            Text="+"
            FontSize="32"
            Padding="0"
            WidthRequest="56"
            HeightRequest="56"
            CornerRadius="28"
            HorizontalOptions="Start"
            SemanticProperties.Description="Add a product" />

    </Grid>

</ContentPage>