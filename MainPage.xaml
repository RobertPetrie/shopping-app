<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:shopping_app.Models"
    x:Class="shopping_app.MainPage"
    Title="Products">

    <!-- The middle row scrolls; the controls remain fixed. -->
    <Grid
        Padding="16"
        RowDefinitions="Auto,*,Auto"
        RowSpacing="12">

        <!-- Display the product count and current sort direction. -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="12">

            <Label
                x:Name="StatusLabel"
                Text="Loading products..."
                FontSize="16"
                VerticalOptions="Center" />

            <Button
                x:Name="SortProductsButton"
                Grid.Column="1"
                Text="A|Z"
                FontSize="14"
                Padding="0"
                WidthRequest="56"
                HeightRequest="56"
                CornerRadius="28"
                Clicked="OnSortProductsClicked"
                SemanticProperties.Description="Sorted A to Z. Tap to sort Z to A." />
        </Grid>

        <!-- Product selection is handled by the row's tap gesture. -->
        <CollectionView
            x:Name="ProductsView"
            Grid.Row="1"
            SelectionMode="None"
            ItemsLayout="VerticalList">

            <CollectionView.EmptyView>
                <Label
                    Text="No products to display."
                    Margin="0,24"
                    HorizontalTextAlignment="Center" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Product">

                    <!-- Track row creation and recycling so highlighting
                         stays with the correct product. -->
                    <Grid
                        Padding="8,12"
                        RowDefinitions="Auto,Auto"
                        RowSpacing="14"
                        BackgroundColor="Transparent"
                        Loaded="OnProductRowLoaded"
                        Unloaded="OnProductRowUnloaded"
                        BindingContextChanged="OnProductRowBindingContextChanged">

                        <!-- Pass this row's product to the tap handler. -->
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                NumberOfTapsRequired="1"
                                Tapped="OnProductTapped"
                                CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>

                        <Label
                            Text="{Binding Name}"
                            FontSize="20"
                            FontAttributes="Bold"
                            SemanticProperties.Hint="Tap to edit product" />

                        <!-- Separate product rows in either theme. -->
                        <BoxView
                            Grid.Row="1"
                            HeightRequest="1"
                            Color="{AppThemeBinding Light=#DDDDDD, Dark=#444444}" />
                    </Grid>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <!-- Open the same detail page with an empty form for Add mode. -->
        <Button
            x:Name="AddProductButton"
            Grid.Row="2"
            Text="+"
            FontSize="32"
            Padding="0"
            WidthRequest="56"
            HeightRequest="56"
            CornerRadius="28"
            HorizontalOptions="Start"
            Clicked="OnAddProductClicked"
            SemanticProperties.Description="Add a product" />

    </Grid>

</ContentPage>