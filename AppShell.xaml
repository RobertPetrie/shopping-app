<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="shopping_app.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:shopping_app"
    xmlns:pages="clr-namespace:shopping_app.Pages"
    Title="Shopping App"
    FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False">

    <TabBar>
        <!-- Shopping Lists is the first screen shown when the app opens. -->
        <Tab
            Icon="tab_list.png">

            <ShellContent
                Title="Shopping Lists"
                Route="ShoppingLists"
                ContentTemplate="{DataTemplate pages:ShoppingListsPage}" />
        </Tab>

        <Tab
            Icon="tab_product.png">

            <ShellContent
                Title="Products"
                Route="Products"
                ContentTemplate="{DataTemplate local:MainPage}" />
        </Tab>
    </TabBar>

</Shell>