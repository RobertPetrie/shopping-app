<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="shopping_app.Pages.SettingsPage"
    Title="Settings">

    <ScrollView>
        <VerticalStackLayout
            Padding="24,20"
            Spacing="18"
            MaximumWidthRequest="700"
            HorizontalOptions="Fill">

            <Label
                Text="Settings"
                FontSize="30"
                FontAttributes="Bold" />

            <!-- Sales tax is app-wide because every shopping list uses the same rate. -->
            <Border
                StyleClass="SurfaceContainer,Rounded"
                Padding="20">

                <VerticalStackLayout Spacing="12">
                    <Label
                        Text="Sales tax"
                        FontSize="20"
                        FontAttributes="Bold" />

                    <Label
                        x:Name="TaxRateNameLabel"
                        Text="Loading tax rate..."
                        FontSize="14"
                        TextColor="{AppThemeBinding Light=#6B6B6B, Dark=#C7C7C7}" />

                    <Label
                        Text="Tax rate (%)"
                        FontSize="15"
                        FontAttributes="Bold" />

                    <Entry
                        x:Name="TaxRateEntry"
                        AutomationId="TaxRateEntry"
                        Placeholder="For example, 13.00"
                        Keyboard="Numeric"
                        ReturnType="Done"
                        Completed="OnTaxRateCompleted"
                        TextChanged="OnTaxRateTextChanged"
                        SemanticProperties.Description="Sales tax rate percentage" />

                    <Label
                        x:Name="TaxRateValidationLabel"
                        IsVisible="False"
                        FontSize="14"
                        TextColor="{AppThemeBinding Light=#B3261E, Dark=#FFB4AB}" />

                    <Button
                        x:Name="SaveTaxRateButton"
                        StyleClass="FilledTonalButton"
                        Text="Save tax rate"
                        HorizontalOptions="Start"
                        Clicked="OnSaveTaxRateClicked"
                        SemanticProperties.Description="Save the sales tax rate" />

                    <Label
                        x:Name="TaxRateStatusLabel"
                        FontSize="13"
                        TextColor="{AppThemeBinding Light=#6B6B6B, Dark=#C7C7C7}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
