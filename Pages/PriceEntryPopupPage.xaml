<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="shopping_app.Pages.PriceEntryPopupPage"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    BackgroundColor="#99000000">

    <!--
        This is a modal page, but only the centered card looks interactive.
        The dark backdrop keeps the shopping list visible as the context behind it.
    -->
    <Grid Padding="24">
        <Border
            StyleClass="SurfaceContainer,Rounded"
            Padding="24"
            MaximumWidthRequest="420"
            MinimumWidthRequest="300"
            HorizontalOptions="Center"
            VerticalOptions="Center">

            <Border.Shadow>
                <Shadow
                    Opacity="0.25"
                    Radius="16"
                    Offset="0,6" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="16">
                <Label
                    Text="Item picked up"
                    FontSize="24"
                    FontAttributes="Bold" />

                <Label
                    x:Name="ProductNameLabel"
                    FontSize="17"
                    FontAttributes="Bold" />

                <Label
                    Text="Enter the price paid for this item."
                    FontSize="14"
                    TextColor="{AppThemeBinding Light=#6B6B6B, Dark=#C7C7C7}" />

                <Entry
                    x:Name="PriceEntry"
                    AutomationId="PickedUpPriceEntry"
                    Placeholder="0.00"
                    Keyboard="Numeric"
                    ReturnType="Done"
                    Completed="OnPriceCompleted"
                    TextChanged="OnPriceTextChanged"
                    SemanticProperties.Description="Price paid for this product" />

                <Label
                    x:Name="ValidationLabel"
                    IsVisible="False"
                    FontSize="14"
                    TextColor="{AppThemeBinding Light=#B3261E, Dark=#FFB4AB}" />

                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="12">

                    <Button
                        Text="Cancel"
                        Clicked="OnCancelClicked"
                        SemanticProperties.Description="Cancel entering the price" />

                    <Button
                        Grid.Column="1"
                        StyleClass="FilledTonalButton"
                        Text="Save"
                        Clicked="OnSaveClicked"
                        SemanticProperties.Description="Save the price and mark the item picked up" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentPage>
