<?xml version="1.0" encoding="utf-8" ?>

<!-- Show the header and back button while hiding the main tabs. -->
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="shopping_app.Pages.ProductDetailPage"
    Title="Add Product"
    Shell.NavBarIsVisible="True"
    Shell.TabBarIsVisible="False">

    <!-- Keep the form accessible on smaller screens and when
         the on-screen keyboard reduces the available space. -->
    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="20"
            MaximumWidthRequest="600"
            HorizontalOptions="Fill">

            <!-- Product names will be validated when saving. -->
            <VerticalStackLayout Spacing="6">
                <Label
                    Text="Product name (required)"
                    FontSize="16"
                    FontAttributes="Bold" />

                <Entry
                    x:Name="ProductNameEntry"
                    Placeholder="For example, Green apples"
                    ReturnType="Next"
                    SemanticProperties.Description="Product name, required" />
            </VerticalStackLayout>

            <!-- Allow an optional description with multiple lines. -->
            <VerticalStackLayout Spacing="6">
                <Label
                    Text="Description (optional)"
                    FontSize="16"
                    FontAttributes="Bold" />

                <Editor
                    x:Name="ProductDescriptionEditor"
                    Placeholder="Add any useful details about this product"
                    HeightRequest="140"
                    SemanticProperties.Description="Product description, optional" />
            </VerticalStackLayout>

            <!-- Hidden until the save logic has validation feedback. -->
            <Label
                x:Name="ValidationLabel"
                IsVisible="False"
                TextColor="{AppThemeBinding Light=#B3261E, Dark=#FFB4AB}"
                FontSize="14" />

            <!-- Use symbols instead of visible text.
                 Tooltips and screen-reader labels explain each action.
                 Click handlers will be connected in the next step. -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                <!-- Checkmark: save the product. -->
                <Button
                    x:Name="SaveProductButton"
                    Grid.Column="0"
                    Text="&#x2713;"
                    FontSize="28"
                    HeightRequest="56"
                    Padding="0"
                    ToolTipProperties.Text="Save product"
                    SemanticProperties.Description="Save product" />

                <!-- Cross: cancel without saving. -->
                <Button
                    x:Name="CancelButton"
                    Grid.Column="1"
                    Text="&#x2715;"
                    FontSize="28"
                    HeightRequest="56"
                    Padding="0"
                    ToolTipProperties.Text="Cancel"
                    SemanticProperties.Description="Cancel adding a product" />

            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>