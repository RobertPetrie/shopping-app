<?xml version="1.0" encoding="utf-8" ?>

<!-- Show the header and back button while hiding the main tabs. -->
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="shopping_app.Pages.ProductDetailPage"
    Title="Add Product"
    Shell.NavBarIsVisible="True"
    Shell.TabBarIsVisible="False">

    <!-- Allow the form to scroll on smaller screens or when
         the on-screen keyboard reduces the available space. -->
    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="20"
            MaximumWidthRequest="600"
            HorizontalOptions="Fill">

            <!-- A name is required when saving the product.
                 Validation will be added in the C# code. -->
            <VerticalStackLayout Spacing="6">
                <Label
                    Text="Product name (required)"
                    FontSize="16"
                    FontAttributes="Bold" />

                <Entry
                    x:Name="ProductNameEntry"
                    Placeholder="For example, Green apples"
                    ReturnType="Next"
                    SemanticProperties.Description="Product name, required" />
            </VerticalStackLayout>

            <!-- The description is optional and supports multiple lines. -->
            <VerticalStackLayout Spacing="6">
                <Label
                    Text="Description (optional)"
                    FontSize="16"
                    FontAttributes="Bold" />

                <Editor
                    x:Name="ProductDescriptionEditor"
                    Placeholder="Add any useful details about this product"
                    HeightRequest="140"
                    SemanticProperties.Description="Product description, optional" />
            </VerticalStackLayout>

            <!-- Reserved for validation feedback from the save logic.
                 Hidden until there is a message to display. -->
            <Label
                x:Name="ValidationLabel"
                IsVisible="False"
                TextColor="{AppThemeBinding Light=#B3261E, Dark=#FFB4AB}"
                FontSize="14" />

            <!-- Save and Cancel handlers will be connected next. -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button
                    x:Name="SaveProductButton"
                    Grid.Column="0"
                    Text="Save"
                    SemanticProperties.Description="Save product" />

                <Button
                    x:Name="CancelButton"
                    Grid.Column="1"
                    Text="Cancel"
                    SemanticProperties.Description="Cancel adding a product" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>