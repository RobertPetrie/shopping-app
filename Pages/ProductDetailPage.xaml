<?xml version="1.0" encoding="utf-8" ?>

<!-- Show the header and back button while hiding the main tabs. -->
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="shopping_app.Pages.ProductDetailPage"
    Title="Add Product"
    Shell.NavBarIsVisible="True"
    Shell.TabBarIsVisible="False">

    <!-- Allow scrolling when the keyboard or a smaller screen
         reduces the space available for the form. -->
    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="20"
            MaximumWidthRequest="600"
            HorizontalOptions="Fill">

            <!-- The asterisk identifies the required field.
                 Keep the requirement explicit for screen readers. -->
            <VerticalStackLayout Spacing="6">
                <Label
                    Text="Product name *"
                    FontSize="16"
                    FontAttributes="Bold" />

                <Entry
                    x:Name="ProductNameEntry"
                    Placeholder="For example, Green apples"
                    ReturnType="Next"
                    SemanticProperties.Description="Product name, required" />

                <!-- Reserved for an inline error when Save validation
                     is connected, such as "Enter a product name". -->
                <Label
                    x:Name="ValidationLabel"
                    IsVisible="False"
                    TextColor="{AppThemeBinding Light=#B3261E, Dark=#FFB4AB}"
                    FontSize="14" />
            </VerticalStackLayout>

            <!-- Description can be left empty. -->
            <VerticalStackLayout Spacing="6">
                <Label
                    Text="Description"
                    FontSize="16"
                    FontAttributes="Bold" />

                <Editor
                    x:Name="ProductDescriptionEditor"
                    Placeholder="Add any useful details about this product"
                    HeightRequest="140"
                    SemanticProperties.Description="Product description, optional" />
            </VerticalStackLayout>

            <!-- Explain the asterisk before the form actions. -->
            <Label
                Text="* Required"
                FontSize="12"
                TextColor="{AppThemeBinding Light=#555555, Dark=#CCCCCC}" />

            <!-- Icon buttons retain descriptive tooltips and
                 screen-reader labels. Handlers will be added next. -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                <!-- Checkmark represents Save. -->
                <Button
                    x:Name="SaveProductButton"
                    Grid.Column="0"
                    Text="&#x2713;"
                    FontSize="28"
                    HeightRequest="56"
                    Padding="0"
                    ToolTipProperties.Text="Save product"
                    SemanticProperties.Description="Save product" />

                <!-- Cross represents Cancel. -->
                <Button
                    x:Name="CancelButton"
                    Grid.Column="1"
                    Text="&#x2715;"
                    FontSize="28"
                    HeightRequest="56"
                    Padding="0"
                    ToolTipProperties.Text="Cancel"
                    SemanticProperties.Description="Cancel adding a product" />

            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>